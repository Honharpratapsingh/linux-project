{
  "name": "projecthub",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "PORT=5001 npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "test": "npm run test --workspaces --if-present",
    "migrate": "npm run migrate --workspace=backend",
    "provision:faculty": "npm run provision:faculty --workspace=backend",
    "seed:demo": "npm run seed:demo --workspace=backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e:prepare": "tsx e2e/scripts/prepare.ts",
    "e2e": "npm run e2e:prepare && playwright test --config=e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
