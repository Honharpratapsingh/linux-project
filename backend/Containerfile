# ── Stage 1: Builder ──────────────────────────────────────────────────────────
FROM docker.io/library/node:22.23.5-bookworm-slim AS builder

WORKDIR /build

# Copy lockfile and package manifests
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Install dependencies (including devDependencies needed for TypeScript compiler)
RUN npm ci

# Copy backend source and tsconfig
COPY backend/src ./backend/src
COPY backend/tsconfig.json ./backend/

# Build backend TypeScript
RUN npm run build --workspace=backend

# ── Stage 2: Production Runtime ───────────────────────────────────────────────
FROM docker.io/library/node:22.23.5-bookworm-slim

WORKDIR /app

# Copy lockfile and manifests for production install
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/

# Install only production dependencies
RUN npm ci --omit=dev --workspace=backend --ignore-scripts=false

# Copy compiled JS from builder
COPY --from=builder /build/backend/dist ./dist
RUN mkdir -p ./backend && ln -s /app/dist /app/backend/dist

# Copy migrations
COPY backend/migrations ./migrations
RUN ln -s /app/migrations /app/backend/migrations

# Set ownership to node user
RUN chown -R node:node /app

USER node

EXPOSE 5000

CMD ["node", "dist/server.js"]
