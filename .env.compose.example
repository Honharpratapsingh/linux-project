# ProjectHub Compose Environment Variables Example
# Copy this file to .env.compose and set real values.
# NEVER commit .env.compose to version control.
# Generate strong alphanumeric secrets with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | fold -w 32 | head -n 1

POSTGRES_USER=projecthub
POSTGRES_PASSWORD=YOUR_STRONG_ALPHANUMERIC_PASSWORD_HERE
POSTGRES_DB=projecthub_production
SESSION_SECRET=YOUR_STRONG_RANDOM_SESSION_SECRET_MIN_32_CHARS_HERE
