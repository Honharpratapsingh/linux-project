# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# PostgreSQL — used by backend, migration runner, and tests
DATABASE_URL=postgresql://projecthub:projecthub@localhost:5432/projecthub_dev
TEST_DATABASE_URL=postgresql://projecthub:projecthub@localhost:5432/projecthub_test

# Backend (port 5000 used by macOS AirPlay; local dev uses 5001)
PORT=5001
SESSION_SECRET=change_this_to_a_long_random_string_min_32
TRUST_PROXY_HOPS=1
COOKIE_SECURE=auto
SESSION_TTL_HOURS=8
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Faculty Provisioning Script (npm run provision:faculty)
FACULTY_NAME=
FACULTY_EMAIL=
FACULTY_PASSWORD=

# Demo Seed Script (npm run seed:demo)
DEMO_SEED_PASSWORD=

# Frontend (Vite proxy target — default http://127.0.0.1:5001)
VITE_API_PROXY_TARGET=http://127.0.0.1:5001
VITE_API_BASE_URL=http://localhost:5001
