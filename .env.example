# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development

# PostgreSQL — used by backend and migration runner
DATABASE_URL=postgresql://projecthub:projecthub@localhost:5432/projecthub_dev

# Backend
PORT=5000
SESSION_SECRET=change_this_to_a_long_random_string

# Frontend (Vite public env — prefix with VITE_)
VITE_API_BASE_URL=http://localhost:5000
